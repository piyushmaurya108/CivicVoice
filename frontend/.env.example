# ──────────────────────────────────────────────────
# CivicVoice Frontend — Environment Variables
# Copy to .env before running. All vars must start with VITE_
# ──────────────────────────────────────────────────

# URL of your backend API (no trailing slash)
VITE_API_BASE_URL= xxxxx
# Display name (used in nav and page titles)
VITE_APP_NAME= xxxxxxx
