# ──────────────────────────────────────────────────────────────────────
# CivicVoice Backend — Environment Variables
# Copy this file to `.env` and fill in real values before running.
# ──────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
# Get a free M0 cluster: https://www.mongodb.com/cloud/atlas/register
# After creating the cluster, click "Connect" → "Drivers" → copy the connection string.
# Replace <username>, <password>, and the cluster URL below.
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/civicvoice?retryWrites=true&w=majority

# Google Gemini (free tier)
# Get a free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (free tier — 25 GB storage)
# Sign up at https://cloudinary.com — all 3 values are on the dashboard.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
